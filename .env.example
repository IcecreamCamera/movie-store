# ── movie-store 배포용 환경변수 템플릿 ──
# 이 파일을 .env 로 복사해 값을 채우세요. ( .env 는 gitignore )
#   cp .env.example .env

# 영화 데이터 수집 (movie-service) - KOBIS / TMDB API 키
KOBIS_API_KEY=
TMDB_API_KEY=

# 추천 서비스 (recommend-service) - DeepSeek LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
DEFAULT_MOVIE_GENRE=DRAMA
MOVIE_SERVICE_URL=http://movie-service:8082

# 프론트엔드 (vue-frontend) - API/인증 서버 주소
# 로컬에서 프론트 개발 서버를 띄울 때 사용 (게이트웨이 경유)
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH_SERVER_URL=http://localhost:8080

# (선택) Docker Compose 빌드 시 사용되는 값은 docker-compose.yml 기본값 참고
